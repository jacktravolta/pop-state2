<div class="p-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h5 class="fw-bold mb-1">Liquidación #{{ settlement.id }} <span class="badge" style="background:{% if settlement.estado == 'PAGADA' %}#eef2ff{% elseif settlement.estado == 'ANULADA' %}#fef2f2{% else %}#fef3c7{% endif %};color:{% if settlement.estado == 'PAGADA' %}#4338ca{% elseif settlement.estado == 'ANULADA' %}#991b1b{% else %}#92400e{% endif %}">{{ settlement.estado }}</span></h5>
      <div style="font-size:13px;color:#64748b">{{ settlement.property.direccion }} • {{ settlement.fechaInicio|date('d/m/Y') }} → {{ settlement.fechaTermino|date('d/m/Y') }}</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
  </div>

  <div class="row g-2 mb-3">
    <div class="col-4"><div class="p-2 rounded-3" style="background:#f8fafc"><small style="font-size:10px;color:#64748b">CARGO</small><div class="fw-bold">${{ settlement.totalCargo|number_format(0,',','.') }}</div></div></div>
    <div class="col-4"><div class="p-2 rounded-3" style="background:#fef2f2"><small style="font-size:10px;color:#991b1b">DESC</small><div class="fw-bold">-${{ settlement.totalDescuento|number_format(0,',','.') }}</div></div></div>
    <div class="col-4"><div class="p-2 rounded-3" style="background:#eef2ff"><small style="font-size:10px;color:#4338ca">TOTAL</small><div class="fw-bold" style="color:#6366f1">${{ settlement.total|number_format(0,',','.') }}</div></div></div>
  </div>

  <h6 class="fw-bold" style="font-size:12px">Items ({{ settlement.items|length }})</h6>
  <div class="table-responsive">
    <table class="table table-sm" style="font-size:12px">
      <thead><tr><th>Tipo</th><th>Concepto</th><th class="text-end">Monto</th></tr></thead>
      <tbody>
        {% for item in settlement.items %}
          <tr><td><span class="badge {% if item.tipo == 'DESCUENTO' %}bg-danger{% else %}bg-primary{% endif %}" style="font-size:10px">{{ item.tipo }}</span></td><td>{{ item.descripcion }}</td><td class="text-end fw-bold">${{ item.monto|number_format(0,',','.') }}</td></tr>
        {% else %}
          <tr><td colspan="3" class="text-center py-3" style="color:#94a3b8">Sin items</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {% if settlement.observacion %}<div class="alert mt-3" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;font-size:12px"><b>Obs:</b> {{ settlement.observacion }}</div>{% endif %}
  <div class="text-end mt-3">
    <a href="{{ path('app_settlement_pdf', {'id': settlement.id}) }}" target="_blank" class="btn btn-dark btn-sm rounded-pill px-3"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
    {% if settlement.estado == 'PENDIENTE' %}
      <a href="{{ path('app_settlement_edit', {'id': settlement.id}) }}" class="btn btn-sm rounded-pill px-3" style="background:#6366f1;color:white">Editar</a>
    {% endif %}
  </div>
</div>